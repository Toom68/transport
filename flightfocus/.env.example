# Server-side environment variables for Netlify Functions
# Set these in Netlify dashboard: Site settings → Environment variables
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Jamendo free-music API client ID (read-only catalog access).
# Used by the music-list / music-stream functions to power Focus Music.
# Free signup at https://developer.jamendo.com — no redirect URL or secret needed.
JAMENDO_CLIENT_ID=

# Mapbox access token — used for 3D map rendering and driving directions
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Mapillary access token — used for Street View (Passenger View) in drive mode
# 100% free, owned by Meta, 2.4B+ crowdsourced street-level images
# Get one at https://mapillary.com/dashboard/developers
VITE_MAPILLARY_TOKEN=
